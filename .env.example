# LLM (answering). Leave unset to run offline with the extractive fallback.
ANTHROPIC_API_KEY=
RAG_MODEL=claude-sonnet-5-5

# Embeddings: "hash" (offline, deterministic), "voyage" or "openai"
RAG_EMBEDDING_PROVIDER=hash
VOYAGE_API_KEY=
OPENAI_API_KEY=

# Paths and tuning
RAG_DOCS_DIR=docs
RAG_DB_PATH=data/index.sqlite
RAG_TOP_K=5
RAG_CONFIDENCE_THRESHOLD=0.30
