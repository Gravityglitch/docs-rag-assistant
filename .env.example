# Copy to .env and fill in. Every variable the service reads is listed here with its default.
# Unprefixed keys are provider credentials; everything else is prefixed RAG_.

# ---- Credentials -------------------------------------------------------------------
# Claude answers. Unset = offline extractive stand-in (logs a warning; tests/dev only).
ANTHROPIC_API_KEY=
# Embeddings. With RAG_EMBEDDING_PROVIDER=auto: Voyage if set, else OpenAI if set, else hash.
VOYAGE_API_KEY=
OPENAI_API_KEY=
# Shared secret clients send as X-API-Key on /ask, /ask/stream and /ingest.
# Unset = auth disabled (startup warning). Always set this outside local dev.
RAG_API_KEY=

# ---- Storage -----------------------------------------------------------------------
# Postgres + pgvector. Unset = SQLite at RAG_DB_PATH (local/tests).
DATABASE_URL=
RAG_DB_PATH=data/index.sqlite
RAG_DOCS_DIR=docs

# ---- Models ------------------------------------------------------------------------
RAG_MODEL=claude-sonnet-5-5
# auto | hash | voyage | openai  (hash is deterministic and offline; not for production)
RAG_EMBEDDING_PROVIDER=auto
RAG_EMBED_BATCH_SIZE=64

# ---- Retrieval ---------------------------------------------------------------------
RAG_TOP_K=5
RAG_CANDIDATES=20
# Abstain without calling the LLM when retrieval confidence is below this (0-1).
RAG_CONFIDENCE_THRESHOLD=0.30
# Optional second-stage reranker over the fused candidates.
RAG_RERANK=false
# llm (one Claude call, no extra deps) | cross-encoder (needs `uv sync --extra rerank`)
RAG_RERANKER=llm
RAG_RERANK_CANDIDATES=20
RAG_CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RAG_CHUNK_SIZE=700
RAG_CHUNK_OVERLAP=120

# ---- API ---------------------------------------------------------------------------
RAG_HOST=127.0.0.1
RAG_PORT=8000
# Conversation turns (user+assistant pairs) from the request history passed to the LLM.
RAG_HISTORY_TURNS=6
# Requests with a larger Content-Length are rejected with 413.
RAG_MAX_REQUEST_BYTES=64000
# slowapi syntax, per API key (or client IP when auth is off).
RAG_RATE_LIMIT=60/minute
# Expose Prometheus metrics at /metrics (needs `uv sync --extra metrics`).
RAG_METRICS_ENABLED=false

# ---- Reliability -------------------------------------------------------------------
RAG_LLM_TIMEOUT_SECONDS=60
RAG_LLM_MAX_RETRIES=3
RAG_LLM_MAX_TOKENS=1024
RAG_EMBED_TIMEOUT_SECONDS=30
RAG_EMBED_MAX_RETRIES=3

# ---- Logging -----------------------------------------------------------------------
# true = JSON lines on stderr (production); false = coloured console.
RAG_LOG_JSON=true
RAG_LOG_LEVEL=INFO
